data/interim/
data/processed/*
!data/processed/.gitkeep
!data/processed/split_manifest.csv.gz
data/features/*
!data/features/.gitkeep
data/gold/*
!data/gold/.gitkeep

# Intermediate model files (the final model in models/ is committed on purpose)
models/experiments/
*.partial
*.part

# Tooling
.pytest_cache/
.ipynb_checkpoints/
.streamlit/secrets.toml

# Local copies of the brief
extracted_doc.txt
project.docx

# OS
.DS_Store
Thumbs.db
dist/
.venv-gpu/
~$*
